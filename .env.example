# ==========================================================
# CYBERGUARD SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi ".env" dan isi kredensial asli Anda.
# ==========================================================

# Identitas Aplikasi
APP_NAME=CYBERGUARD SENTINEL
APP_VERSION=1.0.0

# Mode Operasi Utama: LIVE (Real-Time) atau DEMO (Simulasi Offline)
DEFAULT_MODE=LIVE

# Koneksi Database (Pilih salah satu: SQLite Lokal atau TiDB Cloud)
# Opsi A — SQLite Lokal (Default jika dikosongkan):
# DATABASE_URL=sqlite:///data/cyberguard_sentinel.db

# Opsi B — TiDB Serverless Cloud (Ganti dengan kredensial cluster Anda):
DATABASE_URL=mysql+pymysql://USER_TIDB_ANDA:PASSWORD_TIDB_ANDA@HOST_TIDB_ANDA:4000/cyberguard_sentinel

# Batasan Keamanan & Port Scanner Guardrails
DEFAULT_SCAN_TARGET=127.0.0.1
MAX_PORTS_PER_SCAN=100
SCAN_TIMEOUT_SECONDS=0.5

# Batasan HTTP Phishing Analyzer
HTTP_REQUEST_TIMEOUT=5
MAX_HTTP_REDIRECTS=3

# Konfigurasi Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/cyberguard_sentinel.log